# =================================================================
# RAJINQU - Environment Variables Configuration
# =================================================================

# 1. Database Connection (PostgreSQL on Neon DB)
DATABASE_URL="postgresql://username:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/rajinqu_db?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/rajinqu_db?sslmode=require"

# 2. Authentication & App Secrets
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="rajinqu_super_secret_session_key_2026_pondok_pesantren"

# 3. WhatsApp Notification Gateway (Fonnte / Wablas)
# Daftar di https://fonnte.com / https://wablas.com
FONNTE_API_TOKEN="YOUR_FONNTE_API_TOKEN_HERE"
FONNTE_DEVICE_NUMBER="628123456789"

# 4. Google Drive Storage via Google Apps Script (GAS)
# Deploy file scripts/google-apps-script.js sebagai Web App di script.google.com
# Tempelkan Web App Executable URL disini:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXX-YOUR_DEPLOY_ID/exec"
NEXT_PUBLIC_GAS_UPLOAD_URL="https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXX-YOUR_DEPLOY_ID/exec"

# 5. App Setting
NEXT_PUBLIC_APP_NAME="RajinQu"
NEXT_PUBLIC_APP_TAGLINE="Monitoring Kegiatan Santri Liburan"
